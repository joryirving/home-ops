{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process annotated dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: [
        // # renovate: datasource=github-releases depName=foo/bar
        // foobar_version: v1.0.0
        // # renovate: datasource=docker depName=ghcr.io/foo/bar
        // FOOBAR_VERSION=v1.0.0
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
    },
    {
      customType: "regex",
      description: "Digest-pinned images inside GATEPROFILE_MAP JSON (invisible to the flux manager)",
      managerFilePatterns: ["/foreman-dispatch-bridge/helmrelease\\.yaml$/"],
      matchStrings: [
        "(?<depName>ghcr\\.io/misospace/[a-z0-9-]+):(?<currentValue>[0-9][^@\"'\\s]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: ["oci://(?<depName>[^:]+):(?<currentValue>\\S+)"],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "Talos machineconfig images",
      managerFilePatterns: ["/talos/.+\\.yaml\\.j2$/"], // only Talos files
      matchStrings: [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\nimage:\\s*(?<currentValue>.+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "MCP Server npm packages",
      managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
      matchStrings: ["npx\\s+-y\\s+(?<depName>@?[^@\\s]+)(?:@(?<currentValue>\\S+))?"],
      datasourceTemplate: "npm",
      versioningTemplate: "loose",
    },
  ],
}
