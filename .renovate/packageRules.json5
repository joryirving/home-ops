{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: ["Custom versioning for mylar3"],
      matchDatasources: ["docker"],
      versioning: "regex:^version-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      matchPackageNames: ["/mylar3/"],
    },
    {
      description: ["Custom regex versioning for kyuz0 amd-strix-halo-toolboxes rocm tags"],
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/kyuz0/amd-strix-halo-toolboxes"],
      versioning: "regex:^rocm-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      allowedVersions: "/^rocm-6\\./",
    },
    // ocharted is cluster-internal; redirect Renovate lookups to upstream Helm repos
    {
      description: "ocharted proxy: metrics-server",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/metrics-server/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://kubernetes-sigs.github.io/metrics-server"],
    },
    {
      description: "ocharted proxy: external-dns",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/external-dns/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://kubernetes-sigs.github.io/external-dns"],
    },
    {
      description: "ocharted proxy: descheduler",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/descheduler/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://kubernetes-sigs.github.io/descheduler"],
    },
    {
      description: "ocharted proxy: headlamp",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.jory.dev/kubernetes-sigs.github.io/headlamp/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://kubernetes-sigs.github.io/headlamp"],
    },
    {
      description: "ocharted proxy: nvidia-device-plugin",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.jory.dev/nvidia.github.io/k8s-device-plugin/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://nvidia.github.io/k8s-device-plugin"],
    },
    {
      description: "ocharted proxy: ceph-csi-drivers",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.jory.dev/ceph.github.io/ceph-csi-operator/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://ceph.github.io/ceph-csi-operator"],
    },
    {
      description: "ocharted proxy: k8s-gpu-dra-driver",
      matchDatasources: ["docker"],
      matchPackageNames: ["ocharted.jory.dev/rocm.github.io/k8s-gpu-dra-driver/**"],
      overrideDatasource: "helm",
      overridePackageName: "{{replace '.*/' '' packageName}}",
      registryUrls: ["https://rocm.github.io/k8s-gpu-dra-driver"],
    },
  ],
}
